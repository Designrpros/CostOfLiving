<main class="wrap">
  <section class="hero">
    <div class="crumbs"><a href="/">Europe</a> · <a href="$country_url">$country</a> · $region</div>
    <h1>Cost of living in $name</h1>
    <div class="verdict">
      <span class="verdict-num $verdict_class">$verdict_num</span>
      <span class="verdict-text">$verdict_text</span>
    </div>
    <p class="lede">$lede</p>
  </section>

  <div class="grid">
$cards
  </div>
</main>
